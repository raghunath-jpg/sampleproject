pipeline {
    agent any

    environment {
        EC2_USER = "ubuntu"
        EC2_IP   = "15.206.70.145"
        APP_DIR  = "/home/ubuntu/sampleproject"
        BACKEND_DIR = "backend"
        FRONTEND_DIR = "frontend"

        S3_BUCKET = "aws-frontends3"
        AWS_REGION = "ap-south-1"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'ebc918bd-74ef-4e74-9f38-bd3e8213bc5b',
                    url: 'https://github.com/raghunath-jpg/sampleproject.git'
            }
        }

        stage('Build Frontend') {
            steps {
                dir("${FRONTEND_DIR}") {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy Frontend to S3') {
            steps {
                sh """
                    echo "Uploading frontend to S3..."
                    aws s3 rm s3://$S3_BUCKET --recursive
                    aws s3 cp $FRONTEND_DIR/build/ s3://$S3_BUCKET --recursive
                """
            }
        }

        stage('Deploy Backend to EC2') {
            steps {
                sshagent(credentials: ['2c6af4d8-f480-4329-8191-f91d7a1bf577']) {
                    sh """
                        echo "Connecting to EC2..."

                        ssh -o StrictHostKeyChecking=no $EC2_USER@$EC2_IP '
                            rm -rf $APP_DIR
                            mkdir -p $APP_DIR
                        '

                        scp -o StrictHostKeyChecking=no -r . $EC2_USER@$EC2_IP:$APP_DIR

                        ssh -o StrictHostKeyChecking=no $EC2_USER@$EC2_IP '
                            cd $APP_DIR/$BACKEND_DIR
                            npm install --production

                            pm2 restart sampleproject 2>/dev/null || pm2 start app.js --name sampleproject
                            pm2 save
                        '
                    """
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline Finished"
        }
        success {
            echo "✅ Backend + Frontend Deployment Successful"
        }
        failure {
            echo "❌ Deployment Failed"
        }
    }
}
